#!/usr/bin/env sh
# Self-healing shim: ensure ./gradlew exists and is executable, then no-op.
ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
GRADLEW="$ROOT_DIR/gradlew"

if [ ! -f "$GRADLEW" ]; then
  echo "[gradlew.shim] Creating ./gradlew stub for CI."
  cat > "$GRADLEW" <<'EOF'
#!/usr/bin/env sh
# Root-level fallback gradle wrapper for CI in Expo managed repo.
echo "[CI stub] ./gradlew invoked; no native Gradle project present (Expo managed)."
exit 0
EOF
fi

chmod +x "$GRADLEW" || true
# If CI called gradlew.shim directly, succeed; if they called ./gradlew, this file is a no-op.
exit 0
