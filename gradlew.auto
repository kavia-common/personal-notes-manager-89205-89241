#!/usr/bin/env sh
# Deterministic creation of ./gradlew for CI environments.
set -e
if [ ! -f "./gradlew" ]; then
  echo "[gradlew.auto] Creating ./gradlew stub..."
  cat > ./gradlew <<'EOF'
#!/usr/bin/env sh
# Root-level CI Gradle wrapper stub for Expo-managed repository.
echo "[CI stub] ./gradlew invoked; Expo managed repo (no native Gradle by default)."
exit 0
EOF
fi
chmod +x ./gradlew 2>/dev/null || true
echo "[gradlew.auto] Ensured ./gradlew exists and is executable."
